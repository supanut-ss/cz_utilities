{
  "name": "skill-hub",
  "version": "0.4.0",
  "private": true,
  "description": "Local skill library and AI profile manager for Windows",
  "author": "Skill Hub",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node tests/desktop.smoke.cjs",
    "test:migration:desktop": "node tests/migration.smoke.cjs",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "pack:win": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.64.1",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "local.skillhub.desktop",
    "productName": "Skill Hub",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "lib/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SkillHub-${version}-Windows-x64.exe"
    }
  }
}
